rule aggregate_symbols:
    input:
        config["outDir"]+"/ncRNA_analysis/full_annotation.gff",
        config["outDir"]+"/orthofinder/orthofinder_protein.tsv"
    output:
        config["outDir"]+"/full_annotation.geneSymbols.gff"
    threads:
        4
    params:
        memory_per_thread="10G",
        extra_cluster_opt="",
        walltime="24:00:00",
        outDir=config["outDir"],
        orthofinderTab=config["orthofinderTab"],
        refTogaIsoform=config["refTogaIsoform"],
        refTogaIsoform2=config["refTogaIsoform2"],
        refToga2=config["refToga2"]
