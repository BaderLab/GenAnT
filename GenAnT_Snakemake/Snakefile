import glob
from pathlib import Path

rule all:
    input:
        config["outDir"]+"/full_annotation.geneSymbols.gff"



rule preprocess_data:
    input:
        assembly=config["assemblyFile"]
    output:
        assembly_out=config["outDir"] + "/assembly/assembly.fa"
    threads: 
        1
    params:
        memory_per_thread="8G",
        extra_cluster_opt="",
        walltime="2:00:00",

        source=config["sourceDir"],
        external=config["externalDir"],
        data=config["dataDir"],
        rnaseq=config["rnaseqDir"],
        isoseq=config["isoseqDir"],
        toga=config["TogaDir"],
        refTogaFa=config["refTogaFa"],
        refTogaBed=config["refTogaBed"],
        refTogaIsoform=config["refTogaIsoform"],
        refLiftOffFa=config["refLiftOffFa"],
        refLiftOffGff=config["refLiftOffGff"],
        orthofinderFA=config["orthofinderFA"],
        orthofinderTab=config["orthofinderTab"],
        brakerOdbFaa=config["brakerOdbFaa"],
        outDir=config["outDir"]
    shell:
        """
        echo "Running preflight check: "
        fail=0

        check_file() {{
            local file=$1
            local minsize=${{2:-0}}
            if [[ ! -f "$file" ]]; then
                echo "File not found: $file"
                fail=1
            elif [[ $minsize -gt 0 ]]; then
                size=$(stat -c%s "$file")
                if [[ $size -lt $minsize ]]; then
                    echo "File too small (<$minsize bytes): $file"
                    fail=1
                else
                    echo "File OK: $file"
                fi
            else
                echo "File OK: $file"
            fi
        }}

        check_dir() {{
            local dir=$1
            shift
            local required=("$@")
            if [[ ! -d "$dir" ]]; then
                echo "Directory not found: $dir"
                fail=1
                return
            fi
            echo "Directory OK: $dir"
            for r in "${{required[@]}}"; do
                if [[ ! -e "$dir/$r" ]]; then
                    echo "Missing: $dir/$r"
                    fail=1
                else
                    echo "Found: $dir/$r"
                fi
            done
        }}

        # Preflight checks
        check_file "{params.source}"
        check_dir "{params.external}" stringtie kent Augustus singularity_images TOGA infernal-tblout2gff.pl
        check_dir "{params.data}" braker_protein Rfam uniprot_sprot
        check_file "{input.assembly}" 1000000
        check_dir "{params.rnaseq}"
        check_dir "{params.isoseq}"
        check_dir "{params.toga}"
        check_file "{params.refTogaFa}" 1000000
        check_file "{params.refTogaBed}" 500000
        check_file "{params.refTogaIsoform}"
        check_file "{params.refLiftOffFa}" 1000000
        check_file "{params.refLiftOffGff}" 500000
        check_file "{params.orthofinderFA}" 500000
        check_file "{params.orthofinderTab}"
        check_file "{params.data}/braker_protein/{params.brakerOdbFaa}" 1000000

        echo "==============================="
        if [[ $fail -ne 0 ]]; then
            echo "Preflight check FAILED"
            exit 1
        else
            echo "Preflight check PASSED"
        fi

        echo "Make starting directory structure"
        cp {input.assembly} {output.assembly_out}
        samtools faidx {output.assembly_out}
        mkdir -p "{params.outDir}/transcript_selection"
        """

rule copy_RNAseq: 
    input:
        assembly=config["outDir"]+"/assembly/assembly.fa",
        rnaseqDir=config["rnaseqDir"]
    output:
        directory(config["outDir"]+"/RNAseq_alignment")
