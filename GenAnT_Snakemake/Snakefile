# liftOff

rule liftoff_asm: 
    input:
        config["outDir"]+"/assembly/assembly.fa"
    output:
        config["outDir"]+"/transcript_selection/liftoff.gffread.gff"
    threads:
        16  
    params:
        memory_per_thread="4G",
        extra_cluster_opt="",
        walltime="60:00:00",

        outDir=config["outDir"],
        refLiftOffGff=config["refLiftOffGff"],
        refLiftOffFa=config["refLiftOffFa"]

    shell: 
        """
        cd {params.outDir}

        mkdir -p liftoff

        cd liftoff

        gffutils-cli create {params.refLiftOffGff} -o referencegff_db

        liftoff -db referencegff_db {input} {params.refLiftOffFa} -o ./liftoff.gff -u ./unmapped.liftoff.txt -copies

        gffread ./liftoff.gff --keep-genes -o {output}
        """

rule braker_noRNA: 
    input:
        config["outDir"]+"/assembly/assembly.softmasked.fa",
        config["outDir"]+"/RNAseq_alignment",
        config["outDir"]+"/ISOseq_alignment"
    output:
        config["outDir"]+"/transcript_selection/braker.noRNA.gffread.gff"
    threads:
        28
    params:
        memory_per_thread="12G",
        extra_cluster_opt="",
        walltime="200:00:00",

        outDir=config["outDir"],
        externalDir=config["externalDir"],
        target=config["target"],
        dataDir=config["dataDir"],
        brakerOdbFaa=config["brakerOdbFaa"]

    shell: 
        """
        if [[ $(ls {params.outDir}/RNAseq_alignment | wc -l) -eq 0 && $(ls {params.outDir}/ISOseq_alignment | wc -l) -eq 0 ]] ; then

            echo "We did not find short read or long read RNA-seq data (aligned bam files)"

            scripts/run_braker_noRNAseq.sh {params.outDir} {params.externalDir} {params.target} {params.dataDir} {params.brakerOdbFaa} {threads}

            touch {params.outDir}/transcript_selection/braker.sr.gffread.gff # dummy variable for later
            touch {params.outDir}/transcript_selection/braker.lr.gffread.gff # dummy variable for later
        else

            touch {output}

        fi


        """

rule braker_sr: 
    input:
        config["outDir"]+"/assembly/assembly.softmasked.fa",
        config["outDir"]+"/RNAseq_alignment",
        config["outDir"]+"/ISOseq_alignment"
    output:
        config["outDir"]+"/transcript_selection/braker.sr.gffread.gff"
    threads:
        28
    params:
        memory_per_thread="12G",
        extra_cluster_opt="",
        walltime="200:00:00",

        outDir=config["outDir"],
        externalDir=config["externalDir"],
        target=config["target"],
        dataDir=config["dataDir"],
        brakerOdbFaa=config["brakerOdbFaa"],
        stranded=config["stranded"]

    shell: 
        """
        if [[ $(ls {params.outDir}/RNAseq_alignment | wc -l) -gt 0 ]] ; then
            echo "We detected short read RNAseq"
            if [[ {params.stranded} = "TRUE" ]] ; then 
                echo "You reported that RNAseq is stranded"
                scripts/make_RNAseq_stranded.sh {params.outDir} {threads} 
                scripts/run_braker_stranded.sh {params.outDir} {params.externalDir} {params.target} {params.dataDir} {params.brakerOdbFaa} {threads}
            else
                scripts/run_braker_sr.sh {params.outDir} {params.externalDir} {params.target} {params.dataDir} {params.brakerOdbFaa} {threads}
	    fi
        else
            touch {output}

        fi
        """

